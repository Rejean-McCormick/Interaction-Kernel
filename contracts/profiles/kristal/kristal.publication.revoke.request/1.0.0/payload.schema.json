{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/profiles/kristal.publication.revoke.request/1.0.0/payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "publication_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "replacement_publication_id": {
      "type": ["string", "null"],
      "maxLength": 500
    }
  },
  "required": [
    "publication_id",
    "reason"
  ]
}
