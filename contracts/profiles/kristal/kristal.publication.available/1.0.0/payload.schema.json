{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interaction-kernel.dev/profiles/kristal.publication.available/1.0.0/payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "publication_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "uckk_object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "state": {
      "enum": ["published", "updated"]
    },
    "supersedes_publication_id": {
      "type": ["string", "null"],
      "maxLength": 500
    }
  },
  "required": [
    "publication_id",
    "uckk_object_id",
    "state"
  ]
}
